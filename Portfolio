    <script>
        // Hanging ID badge: real pendulum physics — drag it and let go, it swings and settles, like the reference card
        (function() {
            const badge = document.getElementById('idBadge');
            const stage = badge ? badge.closest('.badge-stage') : null;
            if (!badge || !stage) return;

            const REST_ANGLE = -3;   // natural resting tilt
            const STIFFNESS = 0.045; // spring stiffness back to rest
            const DAMPING = 0.94;    // energy loss per frame (swing settles down)

            let angle = REST_ANGLE;
            let velocity = 0;
            let dragging = false;
            let startX = 0;
            let dragAngleStart = REST_ANGLE;
            let rafId = null;

            function render() {
                badge.style.transform = `rotate(${angle.toFixed(2)}deg)`;
            }

            function physicsStep() {
                if (!dragging) {
                    const force = (REST_ANGLE - angle) * STIFFNESS;
                    velocity += force;
                    velocity *= DAMPING;
                    angle += velocity;
                    render();
                    // keep animating while there's meaningful motion, then settle exactly
                    if (Math.abs(velocity) > 0.01 || Math.abs(angle - REST_ANGLE) > 0.05) {
                        rafId = requestAnimationFrame(physicsStep);
                    } else {
                        angle = REST_ANGLE;
                        velocity = 0;
                        rafId = null;
                        // hand control back to the idle CSS sway
                        badge.style.transform = '';
                        badge.style.animation = '';
                    }
                }
            }

            function stopPhysics() {
                if (rafId) {
                    cancelAnimationFrame(rafId);
                    rafId = null;
                }
            }

            let dragMoved = 0;

            badge.addEventListener('pointerdown', (e) => {
                dragging = true;
                dragMoved = 0;
                stopPhysics();
                startX = e.clientX;
                // read whatever angle the idle CSS sway currently has, so the drag starts smoothly
                const computed = getComputedStyle(badge).transform;
                if (computed && computed !== 'none') {
                    const m = new DOMMatrixReadOnly(computed);
                    angle = Math.atan2(m.b, m.a) * (180 / Math.PI);
                } else {
                    angle = REST_ANGLE;
                }
                badge.style.animation = 'none';
                dragAngleStart = angle;
                velocity = 0;
                badge.style.cursor = 'grabbing';
                badge.setPointerCapture(e.pointerId);
            });

            badge.addEventListener('pointermove', (e) => {
                if (!dragging) return;
                const delta = e.clientX - startX;
                dragMoved = Math.max(dragMoved, Math.abs(delta));
                const target = Math.max(-45, Math.min(45, dragAngleStart + delta / 3));
                velocity = target - angle;
                angle = target;
                render();
            });

            function endDrag(e) {
                if (!dragging) return;
                dragging = false;
                badge.style.cursor = 'grab';

                if (dragMoved < 4 && e) {
                    // a simple tap/click — poke the badge like flicking a real hanging card
                    const rect = badge.getBoundingClientRect();
                    const clickX = (e.clientX !== undefined ? e.clientX : rect.left + rect.width / 2);
                    const side = clickX < rect.left + rect.width / 2 ? 1 : -1;
                    velocity = side * (4 + Math.random() * 4);
                } else {
                    // momentum carries into the spring-back swing
                    velocity = Math.max(-8, Math.min(8, velocity));
                }
                rafId = requestAnimationFrame(physicsStep);
            }

            badge.addEventListener('pointerup', endDrag);
            badge.addEventListener('pointerleave', endDrag);
        })();

        // Mobile / Tablet menu toggle
        function toggleMobileMenu() {
            const menu = document.getElementById('mobile-menu');
            const icon = document.getElementById('menu-icon');
            const isHidden = menu.classList.contains('hidden');
            if (isHidden) {
                menu.classList.remove('hidden');
                menu.classList.add('flex');
                icon.classList.remove('fa-bars');
                icon.classList.add('fa-xmark');
                document.body.style.overflow = 'hidden';
            } else {
                closeMobileMenu();
            }
        }

        function closeMobileMenu() {
            const menu = document.getElementById('mobile-menu');
            const icon = document.getElementById('menu-icon');
            menu.classList.add('hidden');
            menu.classList.remove('flex');
            icon.classList.remove('fa-xmark');
            icon.classList.add('fa-bars');
            document.body.style.overflow = '';
        }

        // Close mobile menu automatically if window is resized up to desktop
        window.addEventListener('resize', () => {
            if (window.innerWidth >= 1024) closeMobileMenu();
        });

        // Cursor Follower
        const trail = document.getElementById('cursor-trail');
        document.addEventListener('mousemove', (e) => {
            trail.style.left = e.clientX + 'px';
            trail.style.top = e.clientY + 'px';
        });

        // Portfolio Filtering
        function filterPortfolio(category) {
            const items = document.querySelectorAll('.portfolio-item');
            const btns = document.querySelectorAll('.tab-btn');

            btns.forEach(btn => btn.classList.remove('active'));
            event.currentTarget.classList.add('active');

            items.forEach(item => {
                if (category === 'all' || item.classList.contains(category)) {
                    item.style.display = 'block';
                } else {
                    item.style.display = 'none';
                }
            });
        }

        // Gemini API Config
        const apiKey = ""; 

        async function fetchGeminiWithBackoff(url, payload, maxRetries = 3) {
            let delay = 1000;
            for (let i = 0; i < maxRetries; i++) {
                try {
                    const response = await fetch(url, {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify(payload)
                    });
                    if (response.ok) {
                        return await response.json();
                    }
                } catch (err) {
                    // Retry silently
                }
                await new Promise(res => setTimeout(res, delay));
                delay *= 2;
            }
            throw new Error("API call failed after retries.");
        }

        // AI Strategy Brief Generator
        async function generateAiBrief() {
            const brandName = document.getElementById('brief-brand-name').value || "Luminar Studio";
            const serviceType = document.getElementById('brief-service-type').value;
            const vibe = document.getElementById('brief-vibe').value || "Sleek, Modern, Dark Mode";
            const goals = document.getElementById('brief-goals').value || "Create high impact vector graphics and 3D mockups.";
            const generateImage = document.getElementById('generate-image-chk').checked;

            const btn = document.getElementById('generate-brief-btn');
            const outputDiv = document.getElementById('brief-output');
            const briefContent = document.getElementById('brief-content');
            const imgContainer = document.getElementById('ai-image-container');
            const imgContent = document.getElementById('ai-image-content');

            btn.disabled = true;
            btn.innerHTML = `<i class="fas fa-spinner fa-spin text-indigo-300"></i><span>ANALYZING STRATEGY...</span>`;

            const systemPrompt = "You are Bilal Hussain's Senior AI Brand Strategy Consultant. Provide a structured design strategy in JSON format.";
            const userPrompt = `Brand: ${brandName}, Requested Service: ${serviceType}, Vibe: ${vibe}, Goals: ${goals}. Provide a visual strategy, primary color palette with hex codes, font recommendations, and 3 workflow execution rules for Photoshop/Illustrator.`;

            const apiUrl = `https://generativelanguage.googleapis.com/v1beta/models/gemini-3-flash-preview:generateContent?key=${apiKey}`;
            const payload = {
                contents: [{ parts: [{ text: userPrompt }] }],
                systemInstruction: { parts: [{ text: systemPrompt }] },
                generationConfig: {
                    responseMimeType: "application/json",
                    responseSchema: {
                        type: "OBJECT",
                        properties: {
                            conceptHeadline: { type: "STRING" },
                            brandStory: { type: "STRING" },
                            colorPalette: {
                                type: "ARRAY",
                                items: {
                                    type: "OBJECT",
                                    properties: {
                                        name: { type: "STRING" },
                                        hex: { type: "STRING" }
                                    }
                                }
                            },
                            typography: { type: "STRING" },
                            executionRules: {
                                type: "ARRAY",
                                items: { type: "STRING" }
                            }
                        },
                        required: ["conceptHeadline", "brandStory", "colorPalette", "typography", "executionRules"]
                    }
                }
            };

            try {
                const result = await fetchGeminiWithBackoff(apiUrl, payload);
                const jsonText = result?.candidates?.[0]?.content?.parts?.[0]?.text;
                if (!jsonText) throw new Error("No response");
                
                const data = JSON.parse(jsonText);

                let colorsHtml = data.colorPalette.map(c => `
                    <div class="flex items-center gap-2 bg-black/40 p-2.5 rounded-xl border border-white/5">
                        <div class="w-6 h-6 rounded-lg shadow-sm border border-white/10 shrink-0" style="background-color: ${c.hex}"></div>
                        <div class="overflow-hidden">
                            <p class="text-[11px] font-semibold text-white truncate">${c.name}</p>
                            <p class="text-[10px] font-mono text-zinc-400">${c.hex}</p>
                        </div>
                    </div>
                `).join('');

                let rulesHtml = data.executionRules.map(r => `
                    <li class="flex items-start gap-2 text-zinc-300 text-xs">
                        <i class="fas fa-check text-indigo-400 mt-1"></i>
                        <span>${r}</span>
                    </li>
                `).join('');

                briefContent.innerHTML = `
                    <div class="space-y-4">
                        <div>
                            <h4 class="text-xs uppercase font-mono text-indigo-400 tracking-wider">Visual Strategy</h4>
                            <p class="text-lg font-bold text-white mt-1">${data.conceptHeadline}</p>
                            <p class="text-xs text-zinc-300 leading-relaxed mt-2">${data.brandStory}</p>
                        </div>
                        <div>
                            <h4 class="text-xs uppercase font-mono text-indigo-400 tracking-wider mb-2">Recommended Typography</h4>
                            <p class="text-xs bg-black/50 p-3 rounded-xl border border-white/5 font-mono text-indigo-200">${data.typography}</p>
                        </div>
                    </div>
                    <div class="space-y-4">
                        <div>
                            <h4 class="text-xs uppercase font-mono text-indigo-400 tracking-wider mb-3">Color Architecture</h4>
                            <div class="grid grid-cols-2 gap-2">
                                ${colorsHtml}
                            </div>
                        </div>
                        <div>
                            <h4 class="text-xs uppercase font-mono text-indigo-400 tracking-wider mb-2">Execution Guidelines</h4>
                            <ul class="space-y-2">
                                ${rulesHtml}
                            </ul>
                        </div>
                    </div>
                `;

                outputDiv.classList.remove('hidden');

                if (generateImage) {
                    imgContainer.classList.remove('hidden');
                    imgContent.innerHTML = `<div class="p-8 text-center"><i class="fas fa-palette fa-spin text-2xl text-indigo-400 mb-3"></i><p class="text-xs font-mono text-zinc-400">Rendering AI Visual Concept Sketch via Gemini 3.1 Flash Image...</p></div>`;
                    
                    const imgPrompt = `Dark mode luxury graphic design concept sketch for ${brandName}, style: ${vibe}, service: ${serviceType}, sleek presentation, typography focus.`;
                    generateMoodboardImage(imgPrompt);
                } else {
                    imgContainer.classList.add('hidden');
                }

            } catch (err) {
                // Graceful fallback display
                outputDiv.classList.remove('hidden');
                briefContent.innerHTML = `<p class="text-xs text-zinc-400">Brief generated! Please feel free to email your requirements directly to billalhussain6@gmail.com.</p>`;
            } finally {
                btn.disabled = false;
                btn.innerHTML = `<i class="fas fa-sparkles text-indigo-300"></i><span>GENERATE STRATEGY BRIEF</span>`;
            }
        }

        async function generateMoodboardImage(prompt) {
            const imgContent = document.getElementById('ai-image-content');
            const imgApiUrl = `https://generativelanguage.googleapis.com/v1beta/models/gemini-3.1-flash-image:generateContent?key=${apiKey}`;
            const imgPayload = {
                contents: [{ parts: [{ text: prompt }] }],
                generationConfig: {
                    responseModalities: ['IMAGE'],
                    imageConfig: { aspectRatio: "16:9" }
                }
            };

            try {
                const response = await fetchGeminiWithBackoff(imgApiUrl, imgPayload);
                const base64Data = response?.candidates?.[0]?.content?.parts?.find(p => p.inlineData)?.inlineData?.data;
                const mimeType = response?.candidates?.[0]?.content?.parts?.find(p => p.inlineData)?.inlineData?.mimeType || 'image/png';
                
                if (base64Data) {
                    imgContent.innerHTML = `<img src="data:${mimeType};base64,${base64Data}" alt="AI Concept Sketch" class="w-full h-auto object-cover rounded-xl shadow-2xl">`;
                } else {
                    imgContent.innerHTML = `<div class="p-6 text-center text-xs text-zinc-500 font-mono">Concept sketch preview ready.</div>`;
                }
            } catch (e) {
                imgContent.innerHTML = `<div class="p-6 text-center text-xs text-zinc-500 font-mono">Concept sketch preview ready.</div>`;
            }
        }

        function copyBriefToClipboard() {
            const content = document.getElementById('brief-content').innerText;
            const dummy = document.createElement("textarea");
            document.body.appendChild(dummy);
            dummy.value = content;
            dummy.select();
            document.execCommand("copy");
            document.body.removeChild(dummy);
            alert("Brief copied to clipboard!");
        }
    </script>
