        @import url('https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@1,600&family=Inter:wght@300;400;500;600;700;800&family=Plus+Jakarta+Sans:wght@400;600;800&display=swap');
        
        :root {
            --bg: #030308;
            --card-bg: rgba(18, 18, 28, 0.6);
            --accent-blue: #3b82f6;
            --accent-indigo: #6366f1;
            --accent-purple: #8b5cf6;
            --glass-border: rgba(255, 255, 255, 0.08);
        }

        html {
            scroll-snap-type: y proximity;
        }

        body {
            background-color: var(--bg);
            color: #f3f4f6;
            font-family: 'Inter', sans-serif;
            overflow-x: hidden;
        }

        /* Each major section behaves like its own "page" while scrolling */
        .page-section {
            min-height: 100vh;
            scroll-snap-align: start;
            scroll-margin-top: 88px;
            display: flex;
            flex-direction: column;
            justify-content: center;
        }

        @media (max-width: 1024px) {
            html { scroll-snap-type: none; }
            .page-section { min-height: auto; scroll-snap-align: none; }
        }

        .serif { font-family: 'Cormorant Garamond', serif; }
        .heading-font { font-family: 'Plus Jakarta Sans', sans-serif; }

        /* Cursor Glow Element */
        #cursor-trail {
            position: fixed;
            width: 400px;
            height: 400px;
            background: radial-gradient(circle, rgba(99, 102, 241, 0.18) 0%, rgba(59, 130, 246, 0.05) 45%, transparent 70%);
            pointer-events: none;
            z-index: 0;
            transform: translate(-50%, -50%);
            transition: transform 0.08s ease-out;
            border-radius: 50%;
        }

        /* Liquid Glass — layered glassmorphism card */
        .glass-panel {
            position: relative;
            background: linear-gradient(155deg, rgba(255,255,255,0.07) 0%, rgba(15, 17, 26, 0.55) 35%);
            backdrop-filter: blur(22px) saturate(160%);
            -webkit-backdrop-filter: blur(22px) saturate(160%);
            border: 1px solid var(--glass-border);
            border-radius: 24px;
            box-shadow:
                inset 0 1px 1px rgba(255, 255, 255, 0.12),
                inset 0 -1px 12px rgba(99, 102, 241, 0.05),
                0 8px 32px -12px rgba(0, 0, 0, 0.5);
            isolation: isolate;
            overflow: hidden;
        }

        /* Specular highlight sweeping across the top edge — the "liquid" sheen */
        .glass-panel::before {
            content: "";
            position: absolute;
            inset: 0;
            border-radius: inherit;
            padding: 1px;
            background: linear-gradient(135deg, rgba(255,255,255,0.35), rgba(255,255,255,0) 30%, rgba(255,255,255,0) 70%, rgba(129,140,248,0.25));
            -webkit-mask: linear-gradient(#fff 0 0) content-box, linear-gradient(#fff 0 0);
            -webkit-mask-composite: xor;
            mask-composite: exclude;
            pointer-events: none;
            z-index: 1;
        }

        .glass-panel::after {
            content: "";
            position: absolute;
            top: -60%;
            left: -20%;
            width: 60%;
            height: 220%;
            background: linear-gradient(75deg, transparent 40%, rgba(255,255,255,0.05) 50%, transparent 60%);
            pointer-events: none;
            z-index: 1;
        }

        .glass-panel > * {
            position: relative;
            z-index: 2;
        }

        .glass-panel-hover {
            transition: all 0.4s cubic-bezier(0.16, 1, 0.3, 1);
        }

        .glass-panel-hover:hover {
            transform: translateY(-6px);
            border-color: rgba(var(--glow, 99, 102, 241), 0.45);
            box-shadow:
                inset 0 1px 1px rgba(255, 255, 255, 0.18),
                0 20px 45px -15px rgba(var(--glow, 99, 102, 241), 0.38);
        }

        /* Hero Text & Glows */
        .hero-title {
            font-size: clamp(2.6rem, 6.8vw, 6.5rem);
            line-height: 0.95;
            letter-spacing: -0.04em;
        }

        /* ===== Hanging ID Badge Card ===== */
        .badge-stage {
            position: relative;
            width: 380px;
            max-width: 88vw;
            padding-top: 30px;
        }

        /* Fixed anchor string — does NOT rotate, this is where the badge hangs from */
        .badge-string {
            position: absolute;
            top: 0;
            left: 50%;
            width: 2px;
            height: 18px;
            background: linear-gradient(180deg, rgba(255,255,255,0.05), rgba(255,255,255,0.4));
            transform: translateX(-50%);
        }

        /* Everything below swings together as one rigid body, pivoting from the string's end */
        .id-badge-swing {
            position: relative;
            transform: rotate(-3deg);
            transform-origin: top center;
            animation: badge-swing 8s ease-in-out infinite;
            will-change: transform;
            cursor: grab;
            padding-top: 18px;
        }

        @keyframes badge-swing {
            0%, 100% { transform: rotate(-3deg); }
            50% { transform: rotate(2deg); }
        }

        /* Single-piece clip — a pin shape (round head fused with a long shaft), avoids seam/gap glitches */
        .badge-clip {
            position: relative;
            width: 24px;
            height: 96px;
            margin: 0 auto;
            z-index: 4;
        }

        .badge-clip-head {
            position: absolute;
            top: 0;
            left: 50%;
            width: 24px;
            height: 24px;
            transform: translateX(-50%);
            border-radius: 50%;
            background: radial-gradient(circle at 34% 30%, #5a5a66 0%, #1c1c22 55%, #000 100%);
        }

        .badge-clip-shaft {
            position: absolute;
            top: 16px;
            left: 50%;
            width: 12px;
            height: 80px;
            transform: translateX(-50%);
            border-radius: 6px;
            background: linear-gradient(90deg, #050505 0%, #4b4b55 42%, #050505 58%, #050505 100%);
        }

        .id-badge {
            position: relative;
            background: #121218;
            border-radius: 30px;
            overflow: hidden;
            box-shadow: 0 45px 80px -25px rgba(0,0,0,0.75), 0 12px 30px -8px rgba(0,0,0,0.5), 0 0 0 1px rgba(255,255,255,0.06);
        }

        .id-badge-notch {
            position: absolute;
            top: 14px;
            left: 50%;
            transform: translateX(-50%);
            width: 52px;
            height: 10px;
            background: rgba(0,0,0,0.35);
            border-radius: 6px;
            z-index: 3;
        }

        .id-badge-photo-wrap {
            position: relative;
            height: 210px;
            background:
                linear-gradient(135deg, rgba(255,255,255,0.3) 0%, rgba(255,255,255,0) 42%),
                linear-gradient(150deg, #4c1d95 0%, #7c3aed 42%, #a78bfa 78%, #ddd6fe 100%);
            display: flex;
            align-items: center;
            justify-content: center;
            padding-top: 20px;
        }

        .id-badge-photo-ring {
            width: 122px;
            height: 122px;
            border-radius: 50%;
            padding: 4px;
            background: conic-gradient(from 200deg, #22d3ee, #a855f7, #6366f1, #22d3ee);
            box-shadow: 0 10px 22px rgba(0,0,0,0.35);
        }

        .id-badge-photo-gap {
            width: 100%;
            height: 100%;
            border-radius: 50%;
            padding: 4px;
            background: #4c1d95;
        }

        .id-badge-photo {
            width: 100%;
            height: 100%;
            border-radius: 50%;
            object-fit: cover;
            display: block;
        }

        .id-badge-body {
            background: #121218;
            padding: 26px 26px 22px;
            color: #f4f4f5;
        }

        .id-badge-name {
            font-size: 1.45rem;
            font-weight: 800;
            text-align: center;
            letter-spacing: -0.01em;
            color: #ffffff;
        }

        .id-badge-role-wrap {
            text-align: center;
            margin-top: 10px;
        }

        .id-badge-role {
            display: inline-block;
            font-size: 0.8rem;
            font-weight: 600;
            color: #d4d4d8;
            border: 1px solid rgba(255,255,255,0.16);
            border-radius: 999px;
            padding: 5px 16px;
        }

        .id-badge-divider {
            height: 1px;
            background: rgba(255,255,255,0.08);
            margin: 20px 0 16px;
        }

        .id-badge-info-box {
            border: 1px solid rgba(255,255,255,0.1);
            border-radius: 18px;
            padding: 18px 20px;
            background: rgba(255,255,255,0.02);
        }

        .id-badge-grid {
            display: grid;
            grid-template-columns: 1fr 1fr;
            row-gap: 16px;
            column-gap: 10px;
        }

        .id-badge-label {
            display: block;
            font-size: 0.68rem;
            text-transform: uppercase;
            letter-spacing: 0.05em;
            color: #71717a;
            font-weight: 600;
            margin-bottom: 4px;
        }

        .id-badge-value {
            display: block;
            font-size: 0.95rem;
            font-weight: 700;
            color: #f4f4f5;
        }

        .id-badge-status {
            color: #4ade80;
            display: flex;
            align-items: center;
            gap: 6px;
        }

        .id-badge-status i {
            font-size: 8px;
        }

        .id-badge-barcode-box {
            margin-top: 16px;
            border: 1px solid rgba(255,255,255,0.1);
            border-radius: 14px;
            padding: 12px 18px;
            background: rgba(255,255,255,0.02);
            display: flex;
            justify-content: center;
        }

        .id-badge-barcode {
            width: 100%;
            height: 28px;
            background:
                repeating-linear-gradient(90deg, #e4e4e7 0px, #e4e4e7 1px, transparent 1px, transparent 3px),
                repeating-linear-gradient(90deg, #e4e4e7 0px, #e4e4e7 3px, transparent 3px, transparent 6px, #e4e4e7 6px, #e4e4e7 7px, transparent 7px, transparent 11px);
            background-blend-mode: screen;
            opacity: 0.9;
        }

        .id-badge-footer {
            display: flex;
            justify-content: space-between;
            margin-top: 12px;
            font-family: 'JetBrains Mono', monospace;
            font-size: 0.62rem;
            color: #71717a;
            letter-spacing: 0.04em;
        }

        @media (hover: hover) {
            .id-badge-swing:hover {
                animation-play-state: paused;
            }
        }

        .text-gradient {
            background: linear-gradient(135deg, #ffffff 0%, #cbd5e1 50%, #818cf8 100%);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
        }

        .text-gradient-blue {
            background: linear-gradient(135deg, #60a5fa 0%, #6366f1 50%, #a855f7 100%);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
        }

        /* Interactive Buttons */
        .magnetic-btn {
            position: relative;
            background: rgba(255, 255, 255, 0.05);
            border: 1px solid rgba(255, 255, 255, 0.12);
            backdrop-filter: blur(10px);
            padding: 0.85rem 1.8rem;
            border-radius: 9999px;
            transition: all 0.3s ease;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            gap: 10px;
            cursor: pointer;
            font-weight: 600;
        }

        .magnetic-btn:hover {
            background: #ffffff;
            color: #000000;
            border-color: #ffffff;
            transform: translateY(-2px);
            box-shadow: 0 10px 25px rgba(255, 255, 255, 0.2);
        }

        .ai-btn {
            background: linear-gradient(135deg, rgba(59, 130, 246, 0.25), rgba(147, 51, 234, 0.25));
            border: 1px solid rgba(129, 140, 248, 0.4);
        }

        .ai-btn:hover {
            background: linear-gradient(135deg, #3b82f6, #8b5cf6);
            color: #ffffff;
            box-shadow: 0 0 30px rgba(99, 102, 241, 0.5);
        }

        /* Grid pattern overlay */
        .bg-grid {
            position: fixed;
            inset: 0;
            background-image: 
                linear-gradient(to right, rgba(255, 255, 255, 0.03) 1px, transparent 1px),
                linear-gradient(to bottom, rgba(255, 255, 255, 0.03) 1px, transparent 1px);
            background-size: 60px 60px;
            mask-image: radial-gradient(circle at 50% 50%, black 30%, transparent 80%);
            z-index: -1;
            pointer-events: none;
        }

        /* Marquee ticker */
        @keyframes slideMarquee {
            from { transform: translateX(0); }
            to { transform: translateX(-50%); }
        }
        .animate-marquee {
            display: flex;
            width: max-content;
            animation: slideMarquee 30s linear infinite;
        }

        /* Tab active state */
        .tab-btn.active {
            background-color: rgba(99, 102, 241, 0.2);
            border-color: rgba(129, 140, 248, 0.5);
            color: #ffffff;
        }

        /* Custom Scrollbar */
        ::-webkit-scrollbar {
            width: 8px;
        }
        ::-webkit-scrollbar-track {
            background: #030308;
        }
        ::-webkit-scrollbar-thumb {
            background: #1f2937;
            border-radius: 4px;
        }
        ::-webkit-scrollbar-thumb:hover {
            background: #374151;
        }
    </style>
</head>
